{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "launchbox": {
      "type": "remote",
      "url": "https://box.launchscout.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LAUNCHBOX_MCP_TOKEN}"
      },
      "oauth": false
    }
  },
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-sol"
}